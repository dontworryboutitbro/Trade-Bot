# ============================================================
# Fable Fund Lab — environment variables
# Copy this file to .env.local and fill in values.
# NEVER commit .env.local. NEVER prefix secrets with NEXT_PUBLIC_.
# The app runs in MOCK mode with everything left blank.
# ============================================================

# --- Supabase (https://supabase.com → Project Settings → API) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- Anthropic (https://console.anthropic.com → API Keys) ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# --- Alpaca (https://alpaca.markets → Paper Trading → API Keys) ---
ALPACA_PAPER_API_KEY=
ALPACA_PAPER_API_SECRET=
# Live credentials: leave blank until live onboarding is deliberately completed.
ALPACA_LIVE_API_KEY=
ALPACA_LIVE_API_SECRET=

ALPACA_PAPER_BASE_URL=https://paper-api.alpaca.markets
ALPACA_LIVE_BASE_URL=https://api.alpaca.markets
ALPACA_DATA_BASE_URL=https://data.alpaca.markets

# --- App secrets ---
# Random 32+ char strings. Generate with: openssl rand -hex 32
CRON_SECRET=
APP_ENCRYPTION_KEY=
APP_URL=http://localhost:3000

# --- Optional email alerts (https://resend.com) ---
RESEND_API_KEY=
ALERT_EMAIL_TO=
ALERT_EMAIL_FROM=

# --- Optional Discord alerts (server-only webhook) ---
DISCORD_WEBHOOK_URL=

# --- Live pilot (Step 19) — all server-only, hard-capped, audited ---
# Target capital for the live pilot; paper-vs-pilot mismatch warnings use this.
TARGET_LIVE_PILOT_CAPITAL=250
# Hard ceilings for LIVE_MANUAL_PILOT (defaults shown; lowering is always allowed):
PILOT_MAX_CAPITAL_USD=250
PILOT_MAX_POSITION_USD=50
PILOT_MAX_POSITIONS=2
PILOT_MAX_ENTRIES_PER_DAY=2
PILOT_MAX_DAILY_LOSS_USD=10
PILOT_MAX_WEEKLY_LOSS_PCT=3
PILOT_MAX_SPREAD_BPS=25
PILOT_MAX_QUOTE_AGE_SECONDS=60
PILOT_MAX_SLIPPAGE_BPS=30

# --- AI cost control (Step: efficiency) ---
# Max Claude trade-evaluation calls per day. Lower = cheaper while learning.
# Unset defaults: paper modes 4/day, live modes 12/day, mock unlimited (free).
AI_DAILY_BUDGET=24
